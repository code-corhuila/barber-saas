# Contenedor de desarrollo: Metro/Expo con hot-reload, sirviendo el target web.
# El codigo se monta como volumen desde docker-compose, esta imagen solo trae
# node_modules instalado para esa plataforma.
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* .npmrc* ./
RUN npm install

COPY . .

ENV EXPO_NO_TELEMETRY=1

EXPOSE 8081

CMD ["npx", "expo", "start", "--web", "--port", "8081"]
